{
  "name": "k-carrier",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test --test-timeout=180000 --test-force-exit \"core/src/**/*.test.ts\" \"harness/src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings core harness examples",
    "ratchet": "bash scripts/ratchets.sh",
    "check": "pnpm typecheck && pnpm lint && pnpm ratchet && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "oxlint": "^1.0.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^5.6.0"
  }
}
